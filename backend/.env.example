# Copy to .env and fill in your own values. Never commit .env.
# Every setting read by src/config/env.js is listed here; the ones marked
# "optional" fall back to the default shown when left out.

# development / dev / test / local are treated as a developer's machine.
# Anything else (production, staging, ...) is a live server: it refuses to
# start with a weak or example JWT_SECRET.
NODE_ENV=development

PORT=5010

# --- Database (all required) -------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=business_platform_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- Database pool (optional) ------------------------------------------------
# Connections the API keeps open (2-200, default 10). Every API process and
# tool shares PostgreSQL's own limit (100 by default), so raise with care.
DB_POOL_MAX=10
# A request that cannot get a connection within this many ms fails with an
# error instead of waiting for ever (1000-120000, default 15000).
DB_CONNECT_TIMEOUT_MS=15000
# Idle connections are handed back after this many ms (1000-3600000, default 10000).
DB_IDLE_TIMEOUT_MS=10000
# Hold-and-wait guard: "warn" logs, "throw" refuses, any code path that asks
# the pool for a second connection while its transaction holds one. Empty or
# anything else = off (the default). restaurant-money-paths.test.js runs with
# "throw"; run the whole suite with DB_POOL_GUARD=warn to check for 0 warnings.
DB_POOL_GUARD=

# --- Sign-in -----------------------------------------------------------------
# Required. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
# How long a session lasts without being used (default 8h); the screen renews
# it while someone is working.
JWT_EXPIRES_IN=8h

# Key for two-step sign-in (the authenticator-app secrets are encrypted with it).
# Set it ONCE and never change it: changing it stops every authenticator app
# from working (people then sign in with a recovery code and set two-step up
# again). Left empty, it is derived from JWT_SECRET, and then changing
# JWT_SECRET has that effect. On a server that already has people using
# two-step, set it to the current JWT_SECRET value; after that JWT_SECRET can
# be changed freely. A new installation can use a fresh random value
# (same command as above).
TWO_FACTOR_KEY=

# Failed sign-ins one internet address may make per 15 minutes (default 30).
# Successful sign-ins are not counted.
LOGIN_ATTEMPT_LIMIT=30
# Per-account lockout: this many wrong passwords or PINs within the window
# lock that one account or PIN for ACCOUNT_LOCK_MINUTES (defaults 5 / 15 / 15).
ACCOUNT_LOCK_ATTEMPTS=5
ACCOUNT_LOCK_WINDOW_MINUTES=15
ACCOUNT_LOCK_MINUTES=15
# How many times one internet address may send each of the public site's forms
# (signing up, asking to be called back) in an hour (default 5).
SITE_FORM_LIMIT=5
# Seconds a manager's approval (PIN) token stays usable (15-900, default 120).
APPROVAL_TTL_SECONDS=120

# --- Network -----------------------------------------------------------------
# Address(es) of the staff app (apps/business-web) allowed to call this API,
# separated by commas. The guests' site needs no entry: the public guest API
# (/api/public) answers any address.
CORS_ORIGIN=http://localhost:5173
# The guests' site's own address (apps/customer-web), the one the staff app is
# built with in VITE_CUSTOMER_WEB_URL: links the API builds to a guest's page
# start there, unless the restaurant has set a guest web address of its own
# (Service settings). Optional on a developer's machine; a live server refuses
# to start without one guests' phones can open (https, not this computer or a
# local network).
GUEST_WEB_URL=http://localhost:5174
# Number of proxies / load balancers in front of the API (0-10, default 0), so
# rate limits see the real client address. Usually 1 behind a hosting proxy.
TRUST_PROXY=0

# --- Uploaded files (optional) -----------------------------------------------
# UPLOADS_DIR holds the public pictures (menu and product photos), served to
# anyone at /uploads. PRIVATE_UPLOADS_DIR holds the files only ever sent
# through the API: bills attached to expenses and purchase bills, prescription
# scans, task photos. Empty = backend/uploads and backend/private_uploads; a
# relative path is taken from backend/. Both are user data, not code: a live
# server keeps them on persistent storage (a disk or volume that survives a
# redeploy) and backs them up (npm run db:backup copies both). Under
# NODE_ENV=test a folder set only here is not used: each test process gets a
# throwaway folder in the system's temp folder, removed when it ends.
UPLOADS_DIR=
PRIVATE_UPLOADS_DIR=

# --- Live updates (optional) -------------------------------------------------
# Each open live screen (the kitchen display, the POS, the token queue, the
# bell ...) holds one stream open to an API process. LIVE_STREAMS_MAX caps the
# streams one process holds (default 2000); LIVE_STREAMS_PER_PERSON caps one
# login's in one process (default 20: one login on several kitchen screens).
# A screen refused tries again a minute later.
# LIVE_STREAMS_MAX=2000
# LIVE_STREAMS_PER_PERSON=20

# --- Notifications (optional) ------------------------------------------------
# The bell keeps each answer for a few seconds so busy screens do not ask the
# database again, and the standing behind an owner's GST thresholds for five
# minutes. off: never keep them. Under NODE_ENV=test they are kept only with
# on, so a test sees its own changes at once.
# NOTIFICATIONS_CACHE=off

# --- Tools (optional, read by scripts only) ----------------------------------
# Folder holding pg_dump / pg_restore when they are not on PATH (npm run db:backup).
# PG_BIN=C:\Program Files\PostgreSQL\18\bin
